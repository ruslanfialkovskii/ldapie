#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Run LDAPie from a source checkout without installing it:

    ./ldapie --help
    ./ldapie --demo

Installed copies use the `ldapie` console script instead.
"""

import os
import sys

# Prefer the checkout's sources over any installed copy
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from ldapie.ldapie import cli  # noqa: E402

if __name__ == "__main__":
    cli()
